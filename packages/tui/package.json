{
  "name": "@axl/tui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive terminal client for the Axl daemon",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json --force",
    "benchmark": "node benchmark/long-session.ts",
    "test": "pnpm --filter @axl/protocol build && pnpm --filter @axl/kernel build && pnpm --filter @axl/ai build && pnpm --filter @axl/daemon build && node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axl/ai": "workspace:*",
    "@axl/daemon": "workspace:*",
    "@axl/extension-api": "workspace:*",
    "@axl/protocol": "workspace:*",
    "grok-mermaid": "0.2.2",
    "marked": "18.0.11"
  },
  "devDependencies": {
    "@axl/extension-mcp": "workspace:*",
    "@axl/extension-skills": "workspace:*",
    "@axl/kernel": "workspace:*"
  }
}
