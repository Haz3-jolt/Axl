{
  "name": "@kepler/extension-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP 2025-11-25 client integration for Kepler",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json --force",
    "test": "pnpm --filter @kepler/protocol build && pnpm --filter @kepler/kernel build && node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kepler/kernel": "workspace:*",
    "@kepler/protocol": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0"
  }
}
